{
  "version": 2,
  "routes": [
    {
      "src": "/api/weather/(.*)",
      "dest": "/api/weather.js"
    },
    {
      "src": "/images/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/font/(.*)", 
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "continue": true
    }
  ]
}
